# Copia in `.env` e riempi solo la chiave del provider che usi.

# Gemini (default: gemini-2.5-flash)
GEMINI_API_KEY=
# alias accettato: GOOGLE_API_KEY=

# OpenAI (es. --model gpt-4o)
OPENAI_API_KEY=

# Anthropic (es. --model claude-sonnet-5)
ANTHROPIC_API_KEY=

# Modello di default se non passi --model
YT_LEARNER_MODEL=gemini-2.5-flash
